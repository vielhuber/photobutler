#!/usr/bin/env php
<?php
declare(strict_types=1);

require $_composer_autoload_path ?? __DIR__ . '/../vendor/autoload.php';

$options = getopt('', ['root:', 'scan-only', 'tag-only', 'limit:', 'scan-limit:', 'help']);
if (isset($options['help'])) {
    echo "photobutler-index [--root=/app] [--scan-only|--tag-only] [--limit=50] [--scan-limit=100]\n";
    exit(0);
}
if (isset($options['scan-only'], $options['tag-only'])) {
    fwrite(STDERR, "--scan-only und --tag-only schließen sich aus.\n");
    exit(1);
}
foreach (['limit', 'scan-limit'] as $option) {
    if (isset($options[$option]) && filter_var($options[$option], FILTER_VALIDATE_INT, ['options' => ['min_range' => 1]]) === false) {
        fwrite(STDERR, "Limits müssen positive ganze Zahlen sein.\n");
        exit(1);
    }
}
try {
    $library = new \vielhuber\photobutler\PhotoButler((string) ($options['root'] ?? getcwd()));
    if (!isset($options['tag-only'])) {
        echo "Fotoquellen werden gelesen …\n";
        $count = $library->index((int) ($options['scan-limit'] ?? PHP_INT_MAX));
        echo "$count Fotos neu oder aktualisiert.\n";
    }
    if (!isset($options['scan-only'])) {
        echo "KI-Verschlagwortung läuft …\n";
        $count = $library->tag((int) ($options['limit'] ?? 50));
        echo "$count Fotos verschlagwortet.\n";
        $errors = (int) $library->database->query("SELECT COUNT(*) FROM photos WHERE available = 1 AND status = 'error'")->fetchColumn();
        if ($errors > 0) {
            fwrite(STDERR, "$errors Fotos warten nach KI-Fehlern auf Wiederholung.\n");
            exit(1);
        }
    }
} catch (\RuntimeException | \JsonException $exception) {
    fwrite(STDERR, "Photobutler konnte den Lauf nicht abschließen. Fotoquellen, .data/.env und Schreibrechte prüfen.\n");
    exit(1);
}
